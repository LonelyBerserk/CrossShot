{
    "$schema":  "../gen/schemas/desktop-schema.json",
    "identifier":  "default",
    "description":  "Capability for the main window",
    "windows":  [
                    "main",
                    "capture-overlay",
                    "capture-toast",
                    "tray-menu"
                ],
    "permissions":  [
                        "core:default",
                        "core:window:allow-hide",
                        "core:window:allow-toggle-maximize",
                        "core:window:allow-is-maximized",
                        "core:window:allow-start-dragging",
                        "opener:default",
                        "store:default"
                    ]
}