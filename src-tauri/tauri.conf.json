{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "crossshot",
    "version":  "0.1.0",
    "identifier":  "com.crossshot.desktop",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "crossshot",
                                    "decorations": false,
                                    "width":  800,
                                    "height":  600
                                },
                                {
                                    "skipTaskbar":  true,
                                    "resizable":  false,
                                    "alwaysOnTop":  true,
                                    "create":  false,
                                    "shadow":  false,
                                    "focus":  false,
                                    "visible":  false,
                                    "label":  "capture-overlay",
                                    "focusable":  true,
                                    "height":  600,
                                    "backgroundColor":  "#00000000",
                                    "transparent":  true,
                                    "url":  "index.html?window=capture-overlay",
                                    "width":  800,
                                    "decorations":  false,
                                    "title":  "CrossShot Capture Overlay",
                                    "center":  false
                                },
                                {
                                    "label":  "capture-toast",
                                    "title":  "CrossShot Notification",
                                    "url":  "index.html?window=capture-toast",
                                    "width":  68,
                                    "height":  68,
                                    "visible":  false,
                                    "create":  true,
                                    "resizable":  false,
                                    "alwaysOnTop":  true,
                                    "skipTaskbar":  true,
                                    "decorations":  false,
                                    "transparent":  true,
                                    "backgroundColor":  "#00000000",
                                    "shadow":  false,
                                    "focus":  false,
                                    "focusable":  false,
                                    "center":  false
                                }
                            ,
                                {
                                    "label": "tray-menu",
                                    "title": "CrossShot",
                                    "url": "index.html?window=tray-menu",
                                    "width": 160,
                                    "height": 80,
                                    "visible": false,
                                    "create": false,
                                    "resizable": false,
                                    "alwaysOnTop": true,
                                    "skipTaskbar": true,
                                    "decorations": false,
                                    "transparent": true,
                                    "backgroundColor": "#00000000",
                                    "shadow": false,
                                    "focus": true,
                                    "focusable": true,
                                    "center": false
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ]
               }
}